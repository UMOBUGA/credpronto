# Sem DATABASE_URL, a API roda contra um Postgres embutido (PGlite) num
# arquivo local — zero configuração para desenvolver. Defina isto só em
# produção, apontando para um Postgres real (Neon, Supabase, Vercel Postgres
# etc.).
# DATABASE_URL=postgres://user:password@host:5432/credpronto

# Chave mestra de criptografia (AES-256-GCM) para campos sensíveis
# (CPF, renda, tokens do Open Finance). Simplificação de portfólio — em
# produção de verdade isso seria uma chave de um KMS gerenciado, não uma env
# var. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=defina-64-caracteres-hexadecimais-aqui

# Assina o cookie de sessão do portal do dealer.
# SESSION_SECRET=defina-um-valor-aleatorio-aqui

# Chave da API da Anthropic, para extração de documento e parecer de risco.
# Sem ela, a extração falha de forma previsível (documento fica "failed",
# com ação de retry manual no dealer) — não derruba a aplicação.
# ANTHROPIC_API_KEY=sk-ant-...

# Sem BLOB_READ_WRITE_TOKEN, documentos são salvos em .data/uploads/ local.
# Defina isto só em produção (Vercel Blob).
# BLOB_READ_WRITE_TOKEN=

# Protege as rotas de /api/cron/* de serem chamadas por qualquer um.
# Necessário em produção; em dev os endpoints ficam abertos se isto não
# estiver definido.
# CRON_SECRET=defina-um-valor-aleatorio-aqui

# Sem isto (padrão), a esteira usa um client de Open Finance mock — ver
# api/_lib/openfinance.ts. NÃO defina como true: participar do Open Finance
# Brasil de verdade exige a instituição ser autorizada pelo Banco Central,
# inacessível para este projeto de portfólio (ver CLAUDE.md, Fase 5) —
# RealOpenFinanceClient lança em todo método de propósito, nunca finge
# funcionar.
# OPENFINANCE_ENABLED=true

# Janelas (em dias) da varredura de retenção LGPD (api/cron/retention-sweep.ts).
# Padrão: 90 dias para propostas em estado terminal não-aceito
# (denied/expired/cancelled/offer_declined); ~5 anos para offer_accepted
# (mesma ordem de grandeza de guarda de registro financeiro).
# RETENTION_WINDOW_DAYS=90
# RETENTION_WINDOW_ACCEPTED_DAYS=1825
